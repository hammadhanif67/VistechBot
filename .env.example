# Copy to `.env` and fill in before deploying. `.env` is git-ignored.

# The production origin. Canonicals, og:url and sitemap.xml are all written
# with this at build time; leaving it unset ships the placeholder domain.
VITE_SITE_URL=https://your-domain.com

# Where the contact form POSTs. With this unset the form validates and then
# hands over a prefilled email rather than pretending a submission was sent.
VITE_CONTACT_ENDPOINT=
